<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="192dp"
    android:height="192dp"
    android:viewportWidth="192"
    android:viewportHeight="192">
    
    <!-- Background Shield Glow -->
    <path
        android:pathData="M96,24 L32,52 L32,100 C32,142 59,180 96,192 C133,180 160,142 160,100 L160,52 Z"
        android:fillAlpha="0.15">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="96"
                android:startY="24"
                android:endX="96"
                android:endY="192">
                <item android:offset="0" android:color="#8B5CF6"/> <!-- NeonViolet -->
                <item android:offset="1" android:color="#06B6D4"/> <!-- HyperCyan -->
            </gradient>
        </aapt:attr>
    </path>
    
    <!-- Shield Outline -->
    <path
        android:pathData="M96,24 L32,52 L32,100 C32,142 59,180 96,192 C133,180 160,142 160,100 L160,52 Z"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="32"
                android:startY="24"
                android:endX="160"
                android:endY="192">
                <item android:offset="0" android:color="#B28DFF"/>
                <item android:offset="1" android:color="#4AD6E8"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Brain Left Hemisphere -->
    <path
        android:pathData="M92,145 C80,145 65,135 55,120 C45,105 45,85 55,70 C65,55 80,45 92,45"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="50"
                android:startY="45"
                android:endX="92"
                android:endY="145">
                <item android:offset="0" android:color="#8B5CF6"/>
                <item android:offset="1" android:color="#D946EF"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Brain Right Hemisphere -->
    <path
        android:pathData="M100,145 C112,145 127,135 137,120 C147,105 147,85 137,70 C127,55 112,45 100,45"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="100"
                android:startY="45"
                android:endX="147"
                android:endY="145">
                <item android:offset="0" android:color="#06B6D4"/>
                <item android:offset="1" android:color="#3B82F6"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Brain Inner Folds Left -->
    <path
        android:pathData="M92,60 C80,60 70,70 70,85 C70,95 80,105 92,105 M92,80 C85,80 80,90 80,95"
        android:strokeWidth="4"
        android:strokeColor="#A78BFA"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Brain Inner Folds Right -->
    <path
        android:pathData="M100,60 C112,60 122,70 122,85 C122,95 112,105 100,105 M100,80 C107,80 112,90 112,95"
        android:strokeWidth="4"
        android:strokeColor="#67E8F9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Neural Connection lines -->
    <path
        android:pathData="M96,48 L96,142 M75,125 L92,135 M117,125 L100,135"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="96"
                android:startY="48"
                android:endX="96"
                android:endY="142">
                <item android:offset="0" android:color="#8B5CF6"/>
                <item android:offset="0.5" android:color="#FFFFFF"/>
                <item android:offset="1" android:color="#06B6D4"/>
            </gradient>
        </aapt:attr>
    </path>
</vector>
